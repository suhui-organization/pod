# Pod Cloud Web 端 nginx 配置模板(envsubst 注入 upstream;K8s 生产最佳实践)
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- 安全基线 ----
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP:SPA 静态产物,允许 data: 图标/内联样式(Element Plus 需要),不加载第三方脚本
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: wss:; script-src 'self'" always;

    # ---- 传输与压缩 ----
    client_max_body_size 2m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # ---- nginx 自身健康端点(探针用,不依赖后端) ----
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ---- 后端 REST API 反代(前缀与 server 的 /api/v1 对齐) ----
    location /api/ {
        proxy_pass http://${PODCLOUD_SERVER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 保留 Caddy 等上游传入的协议头（直连时该头省略，后端回落 http）
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 300s;  # 流式/长思考:读间隔超时放宽到 300s
        proxy_connect_timeout 5s;
    }

    # 后端健康检查透传(部署手册的验证命令用)
    location = /health {
        proxy_pass http://${PODCLOUD_SERVER_UPSTREAM};
    }

    # ---- 静态资源缓存策略 ----
    # 带哈希的构建产物:长缓存 + immutable(文件名含内容哈希,安全)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html 不缓存:保证发版后立即生效
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA 路由:未命中静态文件时回退 index.html(回退同样不缓存)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
