# Pod Cloud 单机部署环境变量
PODCLOUD_DB_URL=sqlite:////app/data/podcloud.db
PODCLOUD_ENV=production
PUBLIC_BASE_URL=http://127.0.0.1:18088
# 私有化部署时设置（关闭公开注册）:
# PODCLOUD_IS_PRIVATE=true
# 初始管理员:
# ADMIN_EMAIL=admin@your.com
# ADMIN_PASSWORD=your-strong-password

# ── 计费（订阅收费）─────────────────────────────────────────────
# 支付平台：paddle（MoR，默认且当前唯一）。MoR 是法律上的卖家，替你收税、
# 开票、处理拒付；没有海外主体也能收。接新平台需先在 app/services/billing.py
# 实现 Provider 并注册，再改这里。
# PODCLOUD_BILLING_PROVIDER=paddle
#
# 免支付切换套餐。默认值 = (PODCLOUD_ENV == "dev")，即只在开发环境开启。
# 生产务必保持关闭：require_admin 校验的是"租户管理员"，而每个注册用户
# 都是自己租户的管理员 —— 开了就等于任何人一个 API 调用白拿 pro。
# 关闭后仍保留降级到 free 的自助路径，升级必须走支付通道。
# PODCLOUD_ALLOW_PLAN_SWITCH=0
#
# Paddle（留空 = 计费保持未开通，其余功能不受影响）:
# PADDLE_API_KEY=pdl_live_apikey_...
# PADDLE_WEBHOOK_SECRET=ntfset_...
# PADDLE_PRICE_PRO=pri_...                      # 专业版价格 id
# PADDLE_CLIENT_TOKEN=live_...                  # 公开值，前端加载 Paddle.js 用
# PADDLE_ENV=sandbox                            # sandbox | live

# ── 每日巡检 + 失败告警 ──────────────────────────────────────────
# 每天在机器上跑一遍系统自检（数据库/密钥/网关心跳/审计链/策略/模型），
# 结果落库并显示在控制台「系统自检」页；失败时走下面「告警通知」里配好的
# webhook / 邮件渠道推一条，同时在「告警」列表里留一条平台级记录
# （agent 显示为 Pod Cloud，走未解决/已确认/已解决那套处置流程）。
# warn（比如没配 SMTP）默认不推也不建告警。
# PODCLOUD_SELFCHECK_ENABLED=on                 # on（默认）| off
# PODCLOUD_SELFCHECK_HOUR=8                     # 北京时间整点，默认 8
# PODCLOUD_SELFCHECK_REPAIR=0                   # 1 = 巡检时先做安全自修复（默认只报不改）
# PODCLOUD_SELFCHECK_NOTIFY=fail                # fail（默认）| all（连警告一起推）| off
