# ============================================================================
# Pod Cloud 部署配置
#   cp .env.example .env  然后按下面注释填写。只有前两项是必填。
#   install.sh 会在缺失时自动生成 PODCLOUD_JWT_SECRET。
# ============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# 签到后端用的签名密钥（JWT）。**一旦部署后不要再改**：改了所有人会被登出。
# 生成：openssl rand -hex 32
PODCLOUD_JWT_SECRET=

# Web 端口（浏览器访问 http://<主机>:<端口>）
WEB_PORT=18088

# ── 建议填写 ────────────────────────────────────────────────────────────────

# 对外访问地址。用于找回密码邮件里的链接；部署到域名后必须改成真实地址，
# 否则邮件里的链接指向 127.0.0.1。
PUBLIC_BASE_URL=http://127.0.0.1:18088

# 私有化模式：true = 关闭公开注册（只有管理员能建账号）
PODCLOUD_IS_PRIVATE=false

# 找回密码的发信通道。留空 = 不发邮件，重置链接退化写入服务端日志
# （kubectl logs / docker compose logs 可见），自托管下这是既定行为而非降级。
PODCLOUD_SMTP_HOST=
PODCLOUD_SMTP_PORT=465
PODCLOUD_SMTP_USER=
PODCLOUD_SMTP_PASSWORD=
PODCLOUD_SMTP_FROM=

# ── 可选：数据库 ───────────────────────────────────────────────────────────
# 默认 SQLite（卷 podcloud-data）。要换 PostgreSQL 时填连接串，
# 并去掉 docker-compose.yml 里的 PODCLOUD_DB_URL 覆盖。
# PODCLOUD_DB_URL=postgresql+psycopg2://user:pass@host:5432/podcloud

# ── 计费开关（自托管默认关闭）──────────────────────────────────────────────
# auto（默认）= 配了支付通道就启用，没配就关闭
# off          = 强制关闭：前端不显示订阅入口、结账与回调不接受、agent 数量不限
# on           = 强制启用（即使没配好；结账会明确报"未配置"而不是静默失败）
# 本地/私有化部署不需要收费能力，保持 auto 或显式写 off 即可。
# PODCLOUD_BILLING_ENABLED=auto

# 启用计费后填这些（以 Paddle 为例；不填即完全关闭，不影响其它功能）
# PODCLOUD_BILLING_PROVIDER=paddle
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_PRO=
# PADDLE_CLIENT_TOKEN=
# PADDLE_ENV=sandbox

# ── 可选：AI 摘要（不填则相关接口返回"未配置"，其余功能正常）─────────────
# PODCLOUD_LLM_API_KEY=
# PODCLOUD_LLM_BASE_URL=
# PODCLOUD_LLM_MODEL=
